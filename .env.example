# PostgreSQL 접속 정보 (기존 NestJS 서버와 같은 키)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PORT_DOCKER=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_NAME=postgres
# Neon 등 SSL이 필수인 DB에서는 require (로컬 Docker DB는 비워 둔다)
POSTGRES_SSLMODE=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
